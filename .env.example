POSTGRES_PASSWORD=change-me
AGORA_SESSION_SECRET=change-me-to-a-long-random-secret
AGORA_PUBLIC_URL=http://localhost
AGORA_ENABLE_DEV_LOGIN=true
AGORA_DEV_LOGIN_ACCOUNTS=alice:user,bob:user,reporter:user,target:user,moderator:moderator,admin:admin,owner:owner
AGORA_DEV_LOGIN_PROXY_TOKEN=replace-with-a-local-random-secret
# Internal proxy addressing and the exact trusted Caddy address are fixed in Compose.
AGORA_SITE_ADDRESS=localhost:80
AGORA_MIN_CLIENT_VERSION=0.6.0
STEAM_WEB_API_KEY=
# Optional: set both values to enable Microsoft personal-account sign-in.
AGORA_MICROSOFT_CLIENT_ID=
AGORA_MICROSOFT_CLIENT_SECRET=
